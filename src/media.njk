schema:
  - "@context": https://schema.org
    "@type": CollectionPage
    name: Media & Piano Performance - Alec Stevens
    description: A collection of professional photographs and classical piano performance recordings by Alec Stevens.
    url: https://alecstevens.com/media
    isPartOf:
      "@type": WebSite
