      url: https://alecstevens.com
    mainEntity:
      "@type": ImageObject
      name: Alec Stevens Professional Headshot
      description: Black and white professional profile portrait of Alec Stevens, pre-medical student, pianist, researcher, and higher education leader at the University of Utah in Salt Lake City, Utah.
      contentUrl: https://alecstevens.com/images/profile-headshot.jpg
      url: https://alecstevens.com/media
      thumbnail: https://alecstevens.com/images/profile-headshot.jpg
      representativeOfPage: true
      creator:
        "@type": Person
        name: Alec R. Stevens
        url: https://alecstevens.com
      copyrightHolder:
        "@type": Person
        name: Alec R. Stevens
      keywords:
        - Alec Stevens
        - Alec R Stevens
        - professional headshot
        - pre-medical student
        - University of Utah
        - pianist
        - researcher
        - Utah
